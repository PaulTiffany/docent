DOCENT_NAME=Docent
DOCENT_DESCRIPTION=A bounded guide to Docent and its public development frontier.
DOCENT_PROVIDER=mock
DOCENT_MODEL=gpt-4.1-mini
DOCENT_API_KEY=
DOCENT_BASE_URL=https://api.openai.com/v1
DOCENT_CORPUS_PATH=corpus/self-docent.jsonl
DOCENT_CONTRACT_PATH=config/docent.yaml
DOCENT_HISTORY_LIMIT=5
DOCENT_RETRIEVAL_LIMIT=6
DOCENT_MIN_RETRIEVAL_SCORE=0.05
DOCENT_MAX_OUTPUT_TOKENS=700
DOCENT_TEMPERATURE=0.2
DOCENT_REQUEST_TIMEOUT_SECONDS=45
DOCENT_RATE_LIMIT_PER_HOUR=120
DOCENT_ALLOWED_ORIGINS=http://localhost:7860
DOCENT_LOG_LEVEL=INFO
DOCENT_ENVIRONMENT=development
DOCENT_ROOM_HISTORY_LIMIT=100
DOCENT_ROOM_CONTEXT_LIMIT=12
DOCENT_ROOM_QUEUE_LIMIT=20
DOCENT_ROOM_RESET_ENABLED=true
DOCENT_DEVELOPMENT_ROOT=.
