{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocentResponse",
  "type": "object",
  "required": [
    "reply",
    "record_ids",
    "grounded",
    "limitations"
  ],
  "properties": {
    "reply": {
      "type": "string",
      "minLength": 1
    },
    "record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "grounded": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
